# Segredos: configurar no painel do Netlify (Site settings > Environment variables). Nunca commitar .env.
# Resend: https://resend.com (verificar o domínio sethos.com.br com SPF/DKIM antes de enviar)
RESEND_API_KEY=
CONTACT_TO_EMAIL=falecom@sethos.com.br
CONTACT_FROM_EMAIL="SETHOS <contato@sethos.com.br>"

# Cloudflare Turnstile (gratuito). Chaves de TESTE que sempre aprovam, para desenvolvimento:
#   site key  1x00000000000000000000AA   |   secret  1x0000000000000000000000000000000AA
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
