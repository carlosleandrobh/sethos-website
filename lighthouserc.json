{
  "ci": {
    "collect": {
      "startServerCommand": "npm run preview -- --port 4322 --host 127.0.0.1",
      "startServerReadyPattern": "ready in",
      "startServerReadyTimeout": 60000,
      "url": [
        "http://127.0.0.1:4322/",
        "http://127.0.0.1:4322/servicos",
        "http://127.0.0.1:4322/servicos/sustentacao-erp",
        "http://127.0.0.1:4322/quem-somos",
        "http://127.0.0.1:4322/contato"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--headless=new",
        "blockedUrlPatterns": [
          "*kaspersky-labs.com*"
        ],
        "skipAudits": [
          "is-on-https"
        ]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2000
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.1
          }
        ],
        "total-blocking-time": [
          "error",
          {
            "maxNumericValue": 200
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
