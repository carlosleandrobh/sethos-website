---
import { getCollection, render } from 'astro:content';
import { Icon } from 'astro-icon/components';
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ServiceAside from '../../components/ServiceAside.astro';
import { site, ui, whatsappUrl, fill } from '../../lib/content';
import { crumbsJsonLd, serviceJsonLd } from '../../lib/seo';
import { contactFormHref } from '../../lib/url';

export async function getStaticPaths() {
  const all = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
  return all.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, previous: all[i - 1], next: all[i + 1] },
  }));
}

const { entry, previous, next } = Astro.props;
const s = entry.data;
const { Content } = await render(entry);
const t = ui.service;
const url = `${site.url}/servicos/${entry.id}`;
const scheduleUrl = site.schedule.serviceUrl;
const whatsapp = whatsappUrl(fill(t.whatsappMessage, { title: s.title }));
const list = 'mt-5 space-y-3 text-[1.0625rem] leading-relaxed';
const navCard =
  'group flex h-full flex-col rounded-card border border-line p-5 transition-colors hover:border-ink/25 hover:bg-surface';
---

<Base
  title={`${s.title}${t.titleSuffix}`}
  description={s.metaDescription}
  jsonLd={[
    ...serviceJsonLd({ slug: entry.id, title: s.title, description: s.shortDescription, keywords: s.keywords, faq: s.faq }),
    crumbsJsonLd([
      { name: ui.breadcrumb.services, path: '/servicos' },
      { name: s.title, path: `/servicos/${entry.id}` },
    ]),
  ]}
>
  <div class="container-page pt-8">
    <Breadcrumb current={s.title} trail={[{ label: ui.breadcrumb.services, href: '/servicos', title: ui.breadcrumb.allServices }]} />
  </div>

  <header class="container-page pb-10 pt-8 md:pb-14">
    <span class="flex size-14 items-center justify-center rounded-card bg-brand-tint text-brand-dark">
      <Icon name={`lucide:${s.icon}`} class="size-7" aria-hidden="true" />
    </span>
    <h1 class="mt-6 max-w-3xl text-[clamp(2rem,4.6vw,3.5rem)] font-extrabold leading-[1.08] tracking-[-0.03em]">{s.title}</h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink-soft md:text-xl">{s.shortDescription}</p>
    {/* Abaixo de lg a lateral de contato só aparece depois de todo o conteúdo: estes botões a antecipam. */}
    <div class="mt-8 flex flex-col gap-3 sm:flex-row lg:hidden" data-service-header-cta>
      <a href={contactFormHref(entry.id)} class="btn btn-primary min-h-12 px-7 text-base">{site.cta.label}</a>
      <a href={whatsapp} target="_blank" rel="noopener noreferrer" data-contact="whatsapp" class="btn btn-outline min-h-12 px-7 text-base">
        <Icon name="simple-icons:whatsapp" class="size-5" aria-hidden="true" />
        {t.whatsapp}
      </a>
    </div>
  </header>

  <div class="container-page grid gap-12 pb-20 lg:grid-cols-12 lg:gap-16 lg:pb-28">
    <div class="space-y-14 lg:col-span-8">
      <section aria-labelledby="sobre">
        <h2 id="sobre" class="text-2xl md:text-3xl">{t.about}</h2>
        <div class="mt-5 max-w-[42rem] text-lg leading-relaxed [&_p+p]:mt-5"><Content /></div>
      </section>

      <div class="grid gap-12 border-t border-ink/15 pt-10 md:grid-cols-2 md:gap-10">
        <section aria-labelledby="beneficios">
          <h2 id="beneficios" class="text-2xl">{t.benefits}</h2>
          <ul class={list}>
            {
              s.benefits.map((b) => (
                <li class="flex gap-3">
                  <span class="mt-0.5 flex size-6 shrink-0 items-center justify-center rounded-full bg-brand-tint text-brand-dark">
                    <Icon name="lucide:check" class="size-4" aria-hidden="true" />
                  </span>
                  {b}
                </li>
              ))
            }
          </ul>
        </section>

        <section aria-labelledby="incluso">
          <h2 id="incluso" class="text-2xl">{t.features}</h2>
          <ul class={list}>
            {
              s.features.map((f) => (
                <li class="flex gap-3">
                  <span class="mt-2.5 size-1.5 shrink-0 rounded-full bg-ink/40" aria-hidden="true"></span>
                  {f}
                </li>
              ))
            }
          </ul>
        </section>
      </div>

      <section aria-labelledby="faq" class="border-t border-ink/15 pt-10">
        <h2 id="faq" class="text-2xl md:text-3xl">{t.faq}</h2>
        <div class="mt-6 divide-y divide-ink/15 border-y border-ink/15">
          {
            s.faq.map((item) => (
              <details class="group py-1">
                <summary class="flex min-h-12 cursor-pointer list-none items-center justify-between gap-4 py-3 text-lg font-semibold [&::-webkit-details-marker]:hidden">
                  {item.question}
                  <Icon name="lucide:plus" class="size-5 shrink-0 text-brand-dark group-open:hidden" aria-hidden="true" />
                  <Icon name="lucide:minus" class="hidden size-5 shrink-0 text-brand-dark group-open:block" aria-hidden="true" />
                </summary>
                <p class="max-w-[42rem] pb-4 text-lg leading-relaxed text-ink-soft">{item.answer}</p>
              </details>
            ))
          }
        </div>
      </section>

      <section class="section-dark rounded-card p-8 md:p-10" aria-labelledby="cta">
        <span class="accent-rule" aria-hidden="true"></span>
        <h2 id="cta" class="mt-6 text-2xl md:text-3xl">{s.cta.title}</h2>
        <p class="mt-3 max-w-xl text-lg">{s.cta.subtitle}</p>
        <a
          href={scheduleUrl}
          data-contact="schedule"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-on-dark mt-7 min-h-14 px-8"
        >
          {s.cta.button}
        </a>
      </section>

      <nav aria-label={t.navAria} class="grid gap-3 sm:grid-cols-2">
        <div>
          {
            previous && (
              <a href={`/servicos/${previous.id}`} class={navCard}>
                <span class="inline-flex items-center gap-1.5 text-sm text-ink-soft">
                  <Icon name="lucide:arrow-left" class="size-4 transition-transform group-hover:-translate-x-1" aria-hidden="true" />
                  {t.previous}
                </span>
                <span class="mt-2 text-lg font-semibold leading-snug group-hover:text-brand-dark">{previous.data.title}</span>
              </a>
            )
          }
        </div>
        <div>
          {
            next && (
              <a href={`/servicos/${next.id}`} class={`${navCard} sm:items-end sm:text-right`}>
                <span class="inline-flex items-center gap-1.5 text-sm text-ink-soft">
                  {t.next}
                  <Icon name="lucide:arrow-right" class="size-4 transition-transform group-hover:translate-x-1" aria-hidden="true" />
                </span>
                <span class="mt-2 text-lg font-semibold leading-snug group-hover:text-brand-dark">{next.data.title}</span>
              </a>
            )
          }
        </div>
      </nav>
    </div>

    <div class="lg:col-span-4">
      <ServiceAside slug={entry.id} title={s.title} proposalTopic={s.proposalTopic} shortDescription={s.shortDescription} url={url} />
    </div>
  </div>
</Base>
