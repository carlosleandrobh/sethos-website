---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { site, ui } from '../lib/content';
import { fillContactTokens } from '../lib/legal';

export async function getStaticPaths() {
  const pages = await getCollection('legal');
  return pages.map((page) => ({ params: { legal: page.id }, props: { page } }));
}

const { page } = Astro.props;
const { title, description } = page.data;
const { headings } = await render(page);
// {email} e {phone} nos textos vêm de site.yaml (fonte única dos dados de contato).
const html = fillContactTokens(page.rendered?.html ?? '', { email: site.email, phone: site.phone.display });
const sections = headings.filter((h) => h.depth === 2);

// Tipografia do texto jurídico (o Markdown gera h2/p/strong/a sem classes).
const prose = [
  'max-w-[44rem] text-[1.0625rem] leading-relaxed text-ink-soft',
  '[&_h2]:mt-12 [&_h2]:scroll-mt-24 [&_h2]:text-xl [&_h2]:text-ink [&_h2]:first:mt-0 md:[&_h2]:text-2xl',
  '[&_p]:mt-4 [&_strong]:font-semibold [&_strong]:text-ink',
  '[&_a]:text-brand-dark [&_a]:underline [&_a]:underline-offset-4',
].join(' ');
---

<Base title={`${title} - SETHOS`} description={description}>
  <div class="container-page pt-8">
    <Breadcrumb current={title} />
  </div>

  <header class="container-page pb-10 pt-8 md:pb-14">
    <h1 class="text-[clamp(2rem,4.6vw,3.5rem)] font-extrabold leading-[1.08] tracking-[-0.03em]">{title}</h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink-soft md:text-xl">{description}</p>
  </header>

  <div class="container-page grid gap-12 pb-20 lg:grid-cols-12 lg:gap-16">
    <nav aria-label={ui.legal.indexAria} class="lg:col-span-4">
      <ol class="space-y-1 text-sm lg:sticky lg:top-28">
        {
          sections.map((s) => (
            <li>
              <a href={`#${s.slug}`} class="inline-flex min-h-9 items-center text-ink-soft underline-offset-4 hover:text-brand-dark hover:underline">
                {s.text}
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <div class={`lg:col-span-8 ${prose}`}>
      <Fragment set:html={html} />
    </div>
  </div>

  <section class="border-t border-line py-14">
    <div class="container-page grid items-center gap-6 md:grid-cols-[1fr_auto]">
      <div>
        <h2 class="text-2xl">{ui.legal.ctaTitle}</h2>
        <p class="mt-2 text-lg text-ink-soft">{ui.legal.ctaText}</p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row">
        <a href="/contato" class="btn btn-primary min-h-12 px-7 text-base">{ui.legal.ctaPrimary}</a>
        <a href="/servicos" class="btn btn-outline min-h-12 px-7 text-base">{ui.legal.ctaSecondary}</a>
      </div>
    </div>
  </section>
</Base>
