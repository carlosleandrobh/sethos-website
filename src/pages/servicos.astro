---
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { crumbsJsonLd } from '../lib/seo';
import ServiceCard from '../components/ServiceCard.astro';
import CtaBand from '../components/CtaBand.astro';

const page = (await getEntry('servicesIndex', 'services-index'))!.data;
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
// Mesma chamada para contato da home (src/content/pages/home.yaml › contact).
const cta = (await getEntry('home', 'home'))!.data.contact;
---

<Base
  title={page.seo.title}
  description={page.seo.description}
  jsonLd={[crumbsJsonLd([{ name: page.hero.title.join(' '), path: '/servicos' }])]}
>
  <PageHero eyebrow={page.hero.eyebrow} title={page.hero.title} lead={page.hero.lead} />

  <section class="py-12 md:py-20">
    <ul class="container-page grid gap-x-12 md:grid-cols-2">
      {
        services.map((s) => (
          <li>
            <ServiceCard headingLevel={2} slug={s.id} title={s.data.title} description={s.data.shortDescription} icon={s.data.icon} cta={page.cardCta} />
          </li>
        ))
      }
    </ul>
  </section>

  <CtaBand {...cta} />
</Base>
