---
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { ui } from '../lib/content';
import { orgJsonLd, websiteJsonLd } from '../lib/seo';

const home = (await getEntry('home', 'home'))!.data;
const cardCta = (await getEntry('servicesIndex', 'services-index'))!.data.cardCta;
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const featured = services.slice(0, 4);

// Faixa de números: o total de serviços sai da própria coleção, sem digitar.
const { founded, services: servicesCount, coverage } = home.credentials;
const credentials = [founded, { value: String(services.length), label: servicesCount.label }, coverage];
---

<Base title={home.seo.title} description={home.seo.description} jsonLd={[orgJsonLd(home.seo.description), websiteJsonLd()]}>
  <Hero {...home.hero} />

  <section class="border-y border-line" aria-label={ui.home.credentialsAria}>
    <dl class="container-page grid grid-cols-3 divide-x divide-line">
      {
        credentials.map((item) => (
          <div class="flex flex-col-reverse gap-1 py-6 pl-3 first:pl-0 sm:pl-6 md:py-10 md:pl-10">
            <dt class="text-sm leading-snug text-ink-soft md:text-base">{item.label}</dt>
            <dd class="text-3xl font-extrabold leading-none tracking-[-0.03em] text-brand md:text-5xl">{item.value}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section id="quem-somos" class="bg-surface py-16 md:py-28">
    <div class="container-page grid gap-8 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-4">
        <span class="accent-rule" aria-hidden="true"></span>
        <h2 class="mt-6 text-3xl md:text-5xl">{home.about.title}</h2>
      </div>
      <div class="lg:col-span-8">
        <p class="max-w-[42rem] text-lg leading-relaxed text-ink md:text-[1.375rem] md:leading-relaxed">{home.about.text}</p>
        <a href="/quem-somos" class="btn btn-primary mt-8">{home.about.cta}</a>
      </div>
    </div>
  </section>

  <section id="servicos" class="py-16 md:py-28">
    <div class="container-page">
      <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <div class="max-w-2xl">
          <span class="accent-rule" aria-hidden="true"></span>
          <h2 class="mt-6 text-3xl md:text-5xl">{home.services.title}</h2>
          <p class="mt-4 text-lg text-ink-soft">{home.services.subtitle}</p>
        </div>
        <a
          href="/servicos"
          class="btn btn-outline shrink-0 self-start md:self-auto"
          aria-label={ui.home.allServicesAria}
        >
          {home.services.cta}
        </a>
      </div>
      <ul class="mt-10 grid gap-2 sm:grid-cols-2 md:mt-14">
        {
          featured.map((s) => (
            <li>
              <ServiceCard
                slug={s.id}
                title={s.data.title}
                description={s.data.shortDescription}
                icon={s.data.icon}
                cta={cardCta}
              />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand id="contato-resumo" {...home.contact} />
</Base>
