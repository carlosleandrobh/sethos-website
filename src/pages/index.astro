---
import Base from '../layouts/Base.astro';
---

<Base
  title="SETHOS - Consultoria Totvs RM RH"
  description="Consultoria Especializada Totvs RM RH em Belo Horizonte/MG e todo Brasil."
>
  <section class="container-page py-24">
    <p class="eyebrow">Em construção</p>
    <h1 class="mt-2 text-4xl md:text-5xl">SETHOS</h1>
    <p class="mt-4 max-w-xl text-ink-soft">
      Página provisória para validar tokens e layout base (T2). Substituída na T5.
    </p>
    <div class="mt-8 flex gap-3">
      <a href="/contato" class="btn btn-primary">Solicite um contato</a>
      <a href="/servicos" class="btn btn-outline">Nossos serviços</a>
    </div>
  </section>
</Base>
