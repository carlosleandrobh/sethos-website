---
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { ui } from '../lib/content';

const home = (await getEntry('home', 'home'))!.data;
const cardCta = (await getEntry('servicesIndex', 'services-index'))!.data.cardCta;
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const featured = services.slice(0, 4);
---

<Base title={home.seo.title} description={home.seo.description}>
  <Hero {...home.hero} />

  <section class="border-y border-line" aria-label={ui.home.highlightsAria}>
    <ul class="container-page grid divide-y divide-line md:grid-cols-3 md:divide-x md:divide-y-0">
      {
        home.highlights.map((item) => (
          <li class="group relative py-8 md:px-8 md:first:pl-0 md:last:pr-0">
            <h2 class="text-lg font-semibold leading-snug">{item.title}</h2>
            <p class="mt-2 max-w-sm text-[0.9375rem] leading-relaxed text-ink-soft">{item.text}</p>
            <a
              href={item.href}
              class="mt-4 inline-block font-semibold text-brand-dark underline decoration-brand/40 decoration-2 underline-offset-4 transition-colors after:absolute after:inset-0 after:content-[''] group-hover:decoration-brand"
            >
              {item.cta}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section id="quem-somos" class="py-16 md:py-28">
    <div class="container-page grid gap-8 lg:grid-cols-12 lg:gap-12">
      <h2 class="text-3xl md:text-5xl lg:col-span-4">{home.about.title}</h2>
      <div class="lg:col-span-8">
        <p class="max-w-[42rem] text-xl leading-relaxed text-ink md:text-2xl md:leading-relaxed">{home.about.text}</p>
        <a href="/quem-somos" class="btn btn-primary mt-8">{home.about.cta}</a>
      </div>
    </div>
  </section>

  <section id="servicos" class="pb-16 md:pb-28">
    <div class="container-page">
      <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <div class="max-w-2xl">
          <h2 class="text-3xl md:text-5xl">{home.services.title}</h2>
          <p class="mt-4 text-lg text-ink-soft">{home.services.subtitle}</p>
        </div>
        <a
          href="/servicos"
          class="btn btn-outline shrink-0 self-start md:self-auto"
          aria-label={ui.home.allServicesAria}
        >
          {home.services.cta}
        </a>
      </div>
      <ul class="mt-12 grid gap-x-12 sm:grid-cols-2">
        {
          featured.map((s) => (
            <li>
              <ServiceCard
                slug={s.id}
                title={s.data.title}
                description={s.data.shortDescription}
                icon={s.data.icon}
                cta={cardCta}
              />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="contato-resumo" class="bg-brand-dark py-16 text-white md:py-20">
    <div class="container-page grid items-center gap-8 md:grid-cols-[1fr_auto] md:gap-16">
      <div class="max-w-2xl">
        <h2 class="text-3xl text-white md:text-4xl">{home.contact.title}</h2>
        <p class="mt-4 text-lg text-white/90">{home.contact.text}</p>
      </div>
      <a href="/contato" class="btn min-h-12 bg-white px-8 text-base text-brand-dark hover:bg-brand-tint">
        {home.contact.cta}
      </a>
    </div>
  </section>
</Base>
