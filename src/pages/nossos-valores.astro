---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { crumbsJsonLd } from '../lib/seo';

const values = (await getEntry('values', 'values'))!.data;
// Mesma chamada para contato da home (src/content/pages/home.yaml › contact).
const cta = (await getEntry('home', 'home'))!.data.contact;
---

<Base
  title={values.seo.title}
  description={values.seo.description}
  jsonLd={[crumbsJsonLd([{ name: values.hero.title.join(' '), path: '/nossos-valores' }])]}
>
  <PageHero {...values.hero} />

  <section class="py-16 md:py-24">
    <ul class="container-page grid gap-x-12 md:grid-cols-2">
      {
        values.items.map((item, i) => (
          <li class="border-t border-ink/15 py-8">
            <p class="text-sm font-semibold tabular-nums text-brand-dark" aria-hidden="true">{String(i + 1).padStart(2, '0')}</p>
            <h2 class="mt-3 text-xl md:text-2xl">{item.title}</h2>
            <p class="mt-3 max-w-md text-lg leading-relaxed text-ink-soft">{item.text}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <CtaBand {...cta} />
</Base>
