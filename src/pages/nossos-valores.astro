---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { crumbsJsonLd } from '../lib/seo';

const values = (await getEntry('values', 'values'))!.data;
---

<Base
  title={values.seo.title}
  description={values.seo.description}
  jsonLd={[crumbsJsonLd([{ name: values.hero.title.join(' '), path: '/nossos-valores' }])]}
>
  <PageHero {...values.hero} />

  <section class="py-16 md:py-24">
    <ul class="container-page grid gap-x-12 md:grid-cols-2">
      {
        values.items.map((item) => (
          <li class="border-t border-ink/20 py-8">
            <h2 class="text-xl md:text-2xl">{item.title}</h2>
            <p class="mt-3 max-w-md text-lg leading-relaxed text-ink-soft">{item.text}</p>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
