---
import { getEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';

const about = (await getEntry('about', 'about'))!.data;
---

<Base title={about.seo.title} description={about.seo.description}>
  <PageHero {...about.hero} />

  <section class="py-16 md:py-24">
    <div class="container-page grid gap-8 lg:grid-cols-12 lg:gap-12">
      <h2 class="text-3xl md:text-4xl lg:col-span-4">{about.story.title}</h2>
      <div class="space-y-6 lg:col-span-8">
        {about.story.paragraphs.map((p) => <p class="max-w-[42rem] text-lg leading-relaxed md:text-xl md:leading-relaxed">{p}</p>)}
        <a href="/servicos" class="btn btn-primary">{about.story.cta}</a>
      </div>
    </div>
  </section>

  <section class="border-t border-line py-16 md:py-24">
    <div class="container-page grid gap-12 md:grid-cols-2 md:gap-16">
      <div>
        <h2 class="text-2xl md:text-3xl">{about.mission.title}</h2>
        <p class="mt-4 text-lg leading-relaxed text-ink-soft">{about.mission.text}</p>
      </div>
      <div>
        <h2 class="text-2xl md:text-3xl">{about.vision.title}</h2>
        <p class="mt-4 text-lg leading-relaxed text-ink-soft">{about.vision.text}</p>
      </div>
    </div>
  </section>

  <section class="bg-surface py-16 md:py-24">
    <div class="container-page grid gap-8 lg:grid-cols-12 lg:gap-12">
      <h2 class="text-3xl md:text-4xl lg:col-span-4">{about.differentials.title}</h2>
      <ul class="lg:col-span-8">
        {
          about.differentials.items.map((item) => (
            <li class="flex gap-4 border-t border-ink/15 py-5 text-lg first:border-t-0 first:pt-0">
              <Icon name="lucide:check" class="mt-1 size-5 shrink-0 text-brand-dark" aria-hidden="true" />
              {item}
            </li>
          ))
        }
      </ul>
      <p class="lg:col-span-8 lg:col-start-5">
        <a
          href={about.valuesLink.href}
          class="font-semibold text-brand-dark underline decoration-brand/40 decoration-2 underline-offset-4 hover:decoration-brand"
        >
          {about.valuesLink.label}
        </a>
      </p>
    </div>
  </section>
</Base>
