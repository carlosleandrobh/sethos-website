---
import Base from '../layouts/Base.astro';
import { ui } from '../lib/content';

const t = ui.notFound;
---

<Base title={t.title} description={t.description} noindex>
  <section class="container-page flex flex-col items-center py-24 text-center">
    <h1 class="text-6xl font-bold text-ink md:text-7xl">{t.code}</h1>
    <p class="mt-4 text-xl text-ink-soft">{t.heading}</p>
    <p class="mt-3 max-w-md text-ink-soft">{t.text}</p>
    <a href="/" class="btn btn-primary mt-8">{t.cta}</a>
  </section>
</Base>
