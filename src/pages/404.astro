---
import Base from '../layouts/Base.astro';
---

<Base
  title="Página não encontrada | SETHOS"
  description="A página solicitada não foi encontrada. Volte para a página inicial da SETHOS - Consultoria Especializada em Totvs RM."
  noindex
>
  <section class="container-page flex flex-col items-center py-24 text-center">
    <h1 class="text-6xl font-bold text-ink md:text-7xl">404</h1>
    <p class="mt-4 text-xl text-ink-soft">Página não encontrada</p>
    <p class="mt-3 max-w-md text-ink-soft">
      A página solicitada não foi encontrada. Ela pode ter sido movida, excluída ou nunca ter existido.
    </p>
    <a href="/" class="btn btn-primary mt-8">Voltar ao início</a>
  </section>
</Base>
