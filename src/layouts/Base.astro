---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import { site, ui } from '../lib/content';
import { canonicalPath, ogSlug } from '../lib/url';
import { toScript } from '../lib/jsonld';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** Dados estruturados (schema.org) desta página; cada item vira um <script type="application/ld+json">. */
  jsonLd?: object[];
}
const { title, description, noindex = false, jsonLd = [] } = Astro.props;
const canonical = new URL(canonicalPath(Astro.url.pathname), site.url).href;
// Imagem de compartilhamento gerada no build (src/pages/og/[slug].png.ts), uma por página.
const ogImage = new URL(`/og/${ogSlug(Astro.url.pathname)}.png`, site.url).href;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#e53935" />
    <meta name="generator" content={Astro.generator} />
    {
      !noindex && (
        <>
          <meta property="og:type" content="website" />
          <meta property="og:site_name" content={site.name} />
          <meta property="og:locale" content="pt_BR" />
          <meta property="og:title" content={title} />
          <meta property="og:description" content={description} />
          <meta property="og:url" content={canonical} />
          <meta property="og:image" content={ogImage} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:title" content={title} />
          <meta name="twitter:description" content={description} />
          <meta name="twitter:image" content={ogImage} />
        </>
      )
    }
    {jsonLd.map((data) => <script type="application/ld+json" set:html={toScript(data)} />)}
  </head>
  <body id="topo" class="flex min-h-screen flex-col">
    <a
      href="#conteudo"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-control focus:bg-white focus:px-4 focus:py-3 focus:font-semibold focus:text-brand-dark focus:shadow-card-hover"
    >
      {ui.skipLink}
    </a>
    <Navbar />
    <main id="conteudo" tabindex="-1" class="flex-1 focus:outline-none">
      <slot />
    </main>
    <Footer />
    <FloatingWhatsApp />
  </body>
</html>
