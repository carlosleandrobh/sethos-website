---
interface Props {
  eyebrow: string;
  title: string[];
  lead: string;
}
const { eyebrow, title, lead } = Astro.props;
---

<section class="border-b border-line">
  <div class="container-page py-14 md:py-20">
    <p class="text-base font-medium text-brand-dark">{eyebrow}</p>
    <h1 class="mt-3 text-[clamp(2.25rem,5.2vw,4rem)] font-extrabold leading-[1.05] tracking-[-0.03em]">
      {title.map((line) => <span class="block">{line}</span>)}
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-soft md:text-xl">{lead}</p>
  </div>
</section>
