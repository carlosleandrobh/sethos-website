---
import { Icon } from 'astro-icon/components';
import { whatsappUrl } from '../data/site';
---

<a
  href={whatsappUrl()}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Contato via WhatsApp"
  class="fixed bottom-5 right-5 z-40 flex size-14 items-center justify-center rounded-full bg-whatsapp text-white shadow-card-hover transition-transform duration-200 hover:scale-105 md:bottom-6 md:right-6"
>
  <Icon name="simple-icons:whatsapp" class="size-7" aria-hidden="true" />
</a>
