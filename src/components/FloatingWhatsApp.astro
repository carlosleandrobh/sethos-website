---
import { Icon } from 'astro-icon/components';
import { site, ui, whatsappUrl } from '../lib/content';
const onContactPage = Astro.url.pathname.replace(/(\.html|\/)$/, '') === '/contato';
---

{!onContactPage && (
  <div
    id="wa-float"
    class="group fixed bottom-[max(1.25rem,env(safe-area-inset-bottom))] right-5 z-40 transition duration-200 data-[hidden]:pointer-events-none data-[hidden]:translate-y-2 data-[hidden]:opacity-0 md:bottom-6 md:right-6"
  >
    <div
      class="pointer-coarse:hidden pointer-events-none absolute bottom-full right-0 mb-3 w-56 translate-y-1 rounded-card border border-line bg-white p-3 text-left opacity-0 shadow-card-hover transition duration-200 group-focus-within:translate-y-0 group-focus-within:opacity-100 group-hover:translate-y-0 group-hover:opacity-100"
      role="tooltip"
      id="wa-tooltip"
    >
      <p class="text-sm font-semibold text-ink">{site.whatsappTooltip.title}</p>
      <p class="mt-1 text-sm text-ink-soft">{site.whatsappTooltip.text}</p>
    </div>
    <a
      href={whatsappUrl()}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={ui.whatsappFloat.aria}
      title={site.whatsappTooltip.aria}
      aria-describedby="wa-tooltip"
      data-contact="whatsapp"
      class="flex size-14 items-center justify-center rounded-full bg-whatsapp text-white shadow-card-hover"
    >
      <Icon name="simple-icons:whatsapp" class="size-7" aria-hidden="true" />
    </a>
  </div>
)}

<script>
  // O rodapé já tem o WhatsApp: o botão flutuante sai de cena enquanto ele está visível (e não cobre os links de lá).
  const float = document.getElementById('wa-float');
  const footer = document.querySelector('footer');
  if (float && footer && 'IntersectionObserver' in window) {
    new IntersectionObserver(([entry]) => {
      float.toggleAttribute('data-hidden', entry.isIntersecting);
      float.toggleAttribute('inert', entry.isIntersecting);
    }).observe(footer);
  }
</script>
