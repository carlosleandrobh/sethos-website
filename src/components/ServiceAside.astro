---
import { Icon } from 'astro-icon/components';
import { site, ui, whatsappUrl, fill } from '../lib/content';
import { contactFormHref } from '../lib/url';

interface Props {
  title: string;
  proposalTopic: string;
  shortDescription: string;
  url: string;
  /** Identificador do serviço (pré-seleciona o serviço no formulário de contato). */
  slug: string;
}
const { title, proposalTopic, shortDescription, url, slug } = Astro.props;
const t = ui.service;
const linkedin = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`;
const email = `mailto:?subject=${encodeURIComponent(title)}&body=${encodeURIComponent(fill(t.shareEmailBody, { description: shortDescription, url }))}`;
// Mensagem do WhatsApp já com o nome do serviço (src/content/site/ui.yaml › service.whatsappMessage).
const whatsapp = whatsappUrl(fill(t.whatsappMessage, { title }));
const shareButton =
  'flex size-11 items-center justify-center rounded-full border border-ink/20 transition-colors hover:border-brand-dark hover:text-brand-dark';
---

<aside class="space-y-8 lg:sticky lg:top-24">
  <section class="rounded-card border border-line bg-surface p-6 md:p-8" aria-labelledby="interessado">
    <h2 id="interessado" class="text-2xl">{t.interested}</h2>
    <p class="mt-3 text-ink-soft">{t.proposalPrefix}{proposalTopic}</p>

    <div class="mt-6 space-y-3">
      <a href={whatsapp} target="_blank" rel="noopener noreferrer" data-contact="whatsapp" data-service-whatsapp class="btn btn-primary min-h-12 w-full text-base">
        <Icon name="simple-icons:whatsapp" class="size-5" aria-hidden="true" />
        {t.whatsapp}
      </a>
      <a href={contactFormHref(slug)} class="btn btn-outline min-h-12 w-full text-base">{site.cta.label}</a>
    </div>

    <ul class="mt-6 space-y-1 border-t border-ink/15 pt-5 text-[0.9375rem]">
      <li>
        <a href={`tel:${site.phone.tel}`} data-contact="phone" class="inline-flex min-h-10 items-center gap-2 hover:text-brand-dark hover:underline">
          <Icon name="lucide:phone" class="size-4" aria-hidden="true" />{site.phone.display}
        </a>
      </li>
      <li>
        <a href={`mailto:${site.email}`} data-contact="email" class="inline-flex min-h-10 items-center gap-2 hover:text-brand-dark hover:underline">
          <Icon name="lucide:mail" class="size-4" aria-hidden="true" />{site.email}
        </a>
      </li>
    </ul>
  </section>

  <section aria-labelledby="compartilhar">
    <h2 id="compartilhar" class="text-base font-semibold">{t.share}</h2>
    <ul class="mt-3 flex gap-3">
      <li>
        <a href={linkedin} target="_blank" rel="noopener noreferrer" title={t.shareLinkedIn} aria-label={t.shareLinkedIn} class={shareButton}>
          <Icon name="simple-icons:linkedin" class="size-5" aria-hidden="true" />
        </a>
      </li>
      <li>
        <a href={email} title={t.shareEmail} aria-label={t.shareEmail} class={shareButton}>
          <Icon name="lucide:mail" class="size-5" aria-hidden="true" />
        </a>
      </li>
      <li>
        <button type="button" data-copy-link={url} title={t.copyLink} aria-label={t.copyLink} class={shareButton}>
          <Icon name="lucide:link" class="size-5" aria-hidden="true" />
        </button>
      </li>
    </ul>
    <p class="mt-2 hidden text-sm font-medium text-brand-dark" role="status" data-copy-feedback>{t.linkCopied}</p>
  </section>
</aside>

<script>
  const copy = document.querySelector<HTMLButtonElement>('[data-copy-link]');
  const feedback = document.querySelector<HTMLElement>('[data-copy-feedback]');
  copy?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(copy.dataset.copyLink ?? location.href);
      feedback?.classList.remove('hidden');
      setTimeout(() => feedback?.classList.add('hidden'), 2500);
    } catch {
      /* clipboard indisponível: o link continua visível na barra de endereço */
    }
  });
</script>
