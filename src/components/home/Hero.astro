---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import mascot from '../../assets/brand/mascot-hero.png';

interface Props {
  eyebrow: string;
  title: string;
  subtitle: string;
  primaryCta: string;
  secondaryCta: string;
  chips: { label: string; icon: string }[];
}
const { eyebrow, title, subtitle, primaryCta, secondaryCta, chips } = Astro.props;

// "15+ anos de experiência" vira número de credencial + legenda (o texto no conteúdo continua uma frase só).
const [years, ...rest] = eyebrow.split(' ');
const caption = rest.join(' ');
---

<section class="bg-white" aria-labelledby="hero-title">
  <div class="container-page grid items-center gap-12 pb-16 pt-10 md:pt-14 lg:grid-cols-12 lg:gap-8 lg:pb-24 lg:pt-20">
    <div class="lg:col-span-7">
      <h1
        id="hero-title"
        class="text-[clamp(2.5rem,6.2vw,4.75rem)] font-extrabold leading-[1.03] tracking-[-0.035em]"
      >
        {title}
      </h1>

      <p class="mt-7 max-w-[34rem] text-lg leading-relaxed text-ink-soft md:text-xl">{subtitle}</p>

      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <a href="/contato" class="btn btn-primary min-h-12 px-7 text-base">{primaryCta}</a>
        <a href="/servicos" class="btn btn-outline min-h-12 px-7 text-base">{secondaryCta}</a>
      </div>

      <ul class="mt-10 flex flex-wrap gap-x-2 gap-y-2">
        {
          chips.map((chip) => (
            <li class="inline-flex items-center gap-1.5 rounded-full border border-line px-3 py-1.5 text-[0.8125rem] text-ink-soft">
              <Icon name={`lucide:${chip.icon}`} class="size-4 text-brand-dark" aria-hidden="true" />
              {chip.label}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="relative mx-auto w-full max-w-md lg:col-span-5 lg:max-w-none">
      <div class="rise relative aspect-[5/6] rounded-[2rem] bg-footer sm:aspect-[6/5] lg:aspect-[5/6]">
        <div class="absolute bottom-6 left-6 z-10 text-white md:bottom-8 md:left-8">
          <p class="text-5xl font-extrabold leading-none tracking-tight md:text-6xl">{years}</p>
          <p class="mt-2 text-sm text-white/80 md:text-base">{caption}</p>
        </div>
        <Image
          src={mascot}
          alt="Mascote da SETHOS, um robô vermelho apontando para o alto"
          width={420}
          loading="eager"
          fetchpriority="high"
          class="rise-delayed absolute -top-8 right-3 h-[80%] w-auto drop-shadow-2xl sm:-top-10 md:right-6 lg:-top-10 lg:right-5"
        />
      </div>
    </div>
  </div>
</section>
