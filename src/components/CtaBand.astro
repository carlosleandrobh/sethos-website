---
// Faixa de chamada para contato, usada no fim das páginas institucionais.
// Fundo carvão com o vermelho só no filete e no botão (docs/design-notes.md).
// O texto vem do conteúdo (hoje, o bloco `contact` de src/content/pages/home.yaml).
interface Props {
  title: string;
  text: string;
  cta: string;
  href?: string;
  id?: string;
}
const { title, text, cta, href = '/contato', id } = Astro.props;
---

<section id={id} class="section-dark py-16 md:py-24" aria-labelledby="cta-band-title">
  <div class="container-page grid items-end gap-8 md:grid-cols-[1fr_auto] md:gap-16">
    <div class="max-w-2xl">
      <span class="accent-rule" aria-hidden="true"></span>
      <h2 id="cta-band-title" class="mt-6 text-3xl font-extrabold tracking-[-0.025em] md:text-5xl">{title}</h2>
      <p class="mt-5 text-lg leading-relaxed">{text}</p>
    </div>
    <a href={href} class="btn btn-on-dark min-h-14 px-9">{cta}</a>
  </div>
</section>
