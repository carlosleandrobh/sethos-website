---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import wordmark from '../assets/brand/wordmark-white.png';
import { site, whatsappUrl } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="mt-auto bg-footer text-footer-text">
  <div class="container-page grid gap-10 py-14 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <Image
        src={wordmark}
        alt="Logo da SETHOS Tecnologia da Informação - Consultoria Totvs RM RH"
        width={200}
        height={28}
        class="h-7 w-auto"
        loading="lazy"
      />
      <p class="mt-5 max-w-md text-sm leading-relaxed">{site.footer.description}</p>
      <p class="mt-6 text-sm font-semibold text-white">Siga-nos nas redes</p>
      <ul class="mt-3 flex gap-3">
        {
          site.social.map((s) => (
            <li>
              <a
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Siga-nos no ${s.label}`}
                class="flex size-11 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-brand-dark"
              >
                <Icon name={s.icon} class="size-5" aria-hidden="true" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <nav aria-label="Links rápidos do rodapé">
      <h2 class="text-sm font-semibold text-white">Links Rápidos</h2>
      <ul class="mt-4 space-y-1">
        {
          site.nav.map((item) => (
            <li>
              <a href={item.href} class="inline-flex min-h-9 items-center text-sm hover:text-white hover:underline">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <h2 class="text-sm font-semibold text-white">Contato</h2>
      <ul class="mt-4 space-y-3 text-sm">
        <li>
          <a
            href={`mailto:${site.email}`}
            class="inline-flex min-h-9 items-center gap-2 hover:text-white hover:underline"
          >
            <Icon name="lucide:mail" class="size-4 shrink-0" aria-hidden="true" />{site.email}
          </a>
        </li>
        <li>
          <a
            href={`tel:${site.phone.tel}`}
            class="inline-flex min-h-9 items-center gap-2 hover:text-white hover:underline"
          >
            <Icon name="lucide:phone" class="size-4 shrink-0" aria-hidden="true" />{site.phone.display}
          </a>
        </li>
        <li>
          <a
            href={whatsappUrl()}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-9 items-center gap-2 hover:text-white hover:underline"
          >
            <Icon name="simple-icons:whatsapp" class="size-4 shrink-0" aria-hidden="true" />WhatsApp
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-page flex flex-col items-center gap-3 py-8 text-center text-xs">
      <ul class="flex flex-wrap justify-center gap-x-6">
        {
          site.legalNav.map((item) => (
            <li>
              <a href={item.href} class="inline-flex min-h-9 items-center hover:text-white hover:underline">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <p>© {year} {site.legalName}. CNPJ: {site.cnpj}. Todos os direitos reservados.</p>
      <p class="max-w-3xl">{site.footer.disclaimer}</p>
      <a
        href="#topo"
        aria-label="Voltar ao topo"
        class="mt-1 inline-flex size-11 items-center justify-center rounded-full bg-white/10 text-white hover:bg-brand-dark"
      >
        <Icon name="lucide:arrow-up" class="size-5" aria-hidden="true" />
      </a>
    </div>
  </div>
</footer>
