---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import wordmark from '../assets/brand/wordmark-white.png';
import { getCollection } from 'astro:content';
import { site, ui, whatsappUrl, fill } from '../lib/content';

const year = new Date().getFullYear();
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
---

<footer class="mt-auto border-t border-white/10 bg-footer text-footer-text">
  <div class="container-page grid gap-6 py-14 md:grid-cols-2 md:gap-10 lg:grid-cols-[1.3fr_0.8fr_1.3fr_1fr]">
    <div>
      <Image
        src={wordmark}
        alt={ui.footer.logoAlt}
        width={200}
        height={28}
        class="h-7 w-auto"
        loading="lazy"
      />
      <p class="mt-5 max-w-md text-sm leading-relaxed">{site.footer.description}</p>
      <p class="mt-6 text-sm font-semibold text-white">{ui.footer.followUs}</p>
      <ul class="mt-3 flex gap-3">
        {
          site.social.map((s) => (
            <li>
              <a
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${ui.footer.followAria} ${s.label}`}
                class="flex size-11 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-brand-dark"
              >
                <Icon name={s.icon} class="size-5" aria-hidden="true" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <nav aria-label={ui.footer.quickLinksAria} class="border-t border-white/10 pt-4 md:border-0 md:pt-0">
      <details open data-footer-group class="group">
        <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between text-sm font-semibold text-white md:pointer-events-none md:min-h-0 [&::-webkit-details-marker]:hidden">
          <h2 class="text-sm font-semibold text-white">{ui.footer.quickLinks}</h2>
          <Icon name="lucide:chevron-down" class="size-4 transition-transform group-open:rotate-180 md:hidden" aria-hidden="true" />
        </summary>
      <ul class="mt-2 space-y-1 md:mt-4">
        {
          site.footerNav.map((item) => (
            <li>
              <a href={item.href} class="inline-flex min-h-9 items-center text-sm hover:text-white hover:underline">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      </details>
    </nav>

    <nav aria-labelledby="footer-services" class="border-t border-white/10 pt-4 md:border-0 md:pt-0">
      <details open data-footer-group class="group">
        <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between text-sm font-semibold text-white md:pointer-events-none md:min-h-0 [&::-webkit-details-marker]:hidden">
          <h2 id="footer-services" class="text-sm font-semibold text-white">{ui.breadcrumb.services}</h2>
          <Icon name="lucide:chevron-down" class="size-4 transition-transform group-open:rotate-180 md:hidden" aria-hidden="true" />
        </summary>
      <ul class="mt-2 space-y-1 md:mt-4">
        <li>
          <a href="/servicos" class="inline-flex min-h-9 items-center text-sm font-semibold text-white hover:underline">{ui.breadcrumb.allServices}</a>
        </li>
        {
          services.map((s) => (
            <li>
              <a href={`/servicos/${s.id}`} class="inline-flex min-h-9 items-center text-sm hover:text-white hover:underline">
                {s.data.title}
              </a>
            </li>
          ))
        }
      </ul>
      </details>
    </nav>

    <div>
      <h2 class="text-sm font-semibold text-white">{ui.footer.contact}</h2>
      <ul class="mt-4 space-y-3 text-sm">
        <li>
          <a
            href={`mailto:${site.email}`}
            data-contact="email"
            class="inline-flex min-h-9 items-center gap-2 hover:text-white hover:underline"
          >
            <Icon name="lucide:mail" class="size-4 shrink-0" aria-hidden="true" />{site.email}
          </a>
        </li>
        <li>
          <a
            href={`tel:${site.phone.tel}`}
            data-contact="phone"
            class="inline-flex min-h-9 items-center gap-2 hover:text-white hover:underline"
          >
            <Icon name="lucide:phone" class="size-4 shrink-0" aria-hidden="true" />{site.phone.display}
          </a>
        </li>
        <li>
          <a
            href={whatsappUrl()}
            data-contact="whatsapp"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-9 items-center gap-2 hover:text-white hover:underline"
          >
            <Icon name="simple-icons:whatsapp" class="size-4 shrink-0" aria-hidden="true" />{ui.footer.whatsapp}
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-page flex flex-col items-center gap-3 py-8 text-center text-xs">
      <ul class="flex flex-wrap justify-center gap-x-6">
        {
          site.legalNav.map((item) => (
            <li>
              <a href={item.href} class="inline-flex min-h-9 items-center hover:text-white hover:underline">
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <button type="button" data-open-consent class="inline-flex min-h-9 items-center hover:text-white hover:underline">
            {ui.footer.cookieSettings}
          </button>
        </li>
      </ul>
      <p>{fill(ui.footer.copyright, { year, legalName: site.legalName, cnpj: site.cnpj })}</p>
      <p class="max-w-2xl text-footer-text/80">{site.footer.disclaimer}</p>
      <a
        href="#topo"
        aria-label={ui.footer.backToTop}
        class="mt-1 inline-flex size-11 items-center justify-center rounded-full bg-white/10 text-white hover:bg-brand-dark"
      >
        <Icon name="lucide:arrow-up" class="size-5" aria-hidden="true" />
      </a>
    </div>
  </div>
</footer>

<script>
  // No celular as listas do rodapé começam fechadas (sem JS, e no desktop, ficam abertas).
  const mobile = window.matchMedia('(max-width: 767px)');
  const groups = document.querySelectorAll<HTMLDetailsElement>('[data-footer-group]');
  const sync = () => groups.forEach((g) => (g.open = !mobile.matches));
  sync();
  mobile.addEventListener('change', sync);
</script>
