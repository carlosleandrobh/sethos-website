---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import mascot from '../assets/brand/mascot.png';
import wordmark from '../assets/brand/wordmark.png';
import { site, ui } from '../lib/content';

// No build estático o caminho pode vir como /servicos/x.html; normaliza para /servicos/x.
const path = Astro.url.pathname.replace(/(\.html|\/)$/, '') || '/';
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`);

// Submenu do item "Serviços": os serviços na ordem do campo `order`.
const SERVICES_HREF = '/servicos';
const services = (await getCollection('services'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((s) => ({ href: `${SERVICES_HREF}/${s.id}`, label: s.data.title }));
---

<header
  id="site-header"
  class="group/header sticky top-0 z-50 border-b border-transparent bg-white/95 backdrop-blur transition-colors duration-200 data-[scrolled]:border-line"
>
  <nav
    class="container-page flex h-16 items-center justify-between transition-[height] duration-200 md:h-20 md:group-data-[scrolled]/header:h-16"
    aria-label={ui.nav.mainAria}
  >
    <a href="/" class="flex items-center gap-3" aria-label={ui.nav.homeAria}>
      <Image src={mascot} alt="" width={44} height={53} densities={[1, 2, 3]} class="h-10 w-auto transition-[height] duration-200 md:h-12 md:group-data-[scrolled]/header:h-10" loading="eager" />
      <Image
        src={wordmark}
        alt={ui.nav.logoAlt}
        width={160}
        height={22}
        densities={[1, 2, 3]}
        class="h-5 w-auto md:h-6"
        loading="eager"
      />
    </a>

    <ul class="hidden items-center gap-1 lg:flex">
      {
        site.nav.map((item) => {
          return item.href === SERVICES_HREF ? (
            <li class="group relative" data-submenu>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class="nav-link"
              >
                {item.label}
                <Icon
                  name="lucide:chevron-down"
                  class="size-4 transition-transform group-focus-within:rotate-180 group-hover:rotate-180 group-data-[closed]:rotate-0"
                  aria-hidden="true"
                />
              </a>
              {/* Abre ao passar o mouse ou ao focar pelo teclado; Esc fecha (script abaixo). */}
              <div class="invisible absolute left-1/2 top-full z-10 w-[min(36rem,calc(100vw-2rem))] -translate-x-1/2 pt-3 opacity-0 transition-opacity duration-150 group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100 group-data-[closed]:invisible group-data-[closed]:opacity-0">
                <div class="rounded-card border border-line bg-white p-3 shadow-card-hover">
                  <ul class="grid grid-cols-2 gap-1">
                    {services.map((sv) => (
                      <li>
                        <a
                          href={sv.href}
                          aria-current={path === sv.href ? 'page' : undefined}
                          class="menu-item py-2 text-sm hover:text-brand-dark"
                        >
                          {sv.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                  <a
                    href={SERVICES_HREF}
                    class="mt-2 flex min-h-11 items-center gap-2 border-t border-line px-3 pt-2 text-sm font-semibold text-brand-dark hover:underline"
                  >
                    {ui.breadcrumb.allServices}
                    <Icon name="lucide:arrow-right" class="size-4" aria-hidden="true" />
                  </a>
                </div>
              </div>
            </li>
          ) : (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class="nav-link"
              >
                {item.label}
              </a>
            </li>
          );
        })
      }
      <li class="ml-3"><a href={site.cta.href} class="btn btn-primary">{site.cta.label}</a></li>
    </ul>

    <details id="mobile-menu" class="group relative lg:hidden">
      <summary
        class="flex size-11 cursor-pointer list-none items-center justify-center rounded-control text-ink hover:bg-surface [&::-webkit-details-marker]:hidden"
        aria-label={ui.nav.openMenu}
      >
        <Icon name="lucide:menu" class="size-6 group-open:hidden" aria-hidden="true" />
        <Icon name="lucide:x" class="hidden size-6 group-open:block" aria-hidden="true" />
      </summary>
      <div
        class="absolute right-0 top-14 max-h-[calc(100dvh-5rem)] w-80 max-w-[calc(100vw-2rem)] overflow-y-auto overscroll-contain rounded-card border border-line bg-white p-2 shadow-card-hover"
      >
        <ul class="flex flex-col">
          {
            site.nav.map((item) => {
              return item.href === SERVICES_HREF ? (
                <li>
                  {/* No celular, "Serviços" abre a lista dos serviços (com o link para a página de todos). */}
                  <details class="group/sub" open={isActive(item.href) || undefined}>
                    <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between rounded-control px-3 text-base font-medium text-ink hover:bg-surface [&::-webkit-details-marker]:hidden">
                      {item.label}
                      <Icon name="lucide:chevron-down" class="size-5 transition-transform group-open/sub:rotate-180" aria-hidden="true" />
                    </summary>
                    <ul class="mb-1 ml-3 border-l border-line pl-2">
                      <li>
                        <a
                          href={SERVICES_HREF}
                          aria-current={path === SERVICES_HREF ? 'page' : undefined}
                          class="flex min-h-11 items-center rounded-control px-3 text-[0.9375rem] font-semibold text-brand-dark hover:bg-surface aria-[current=page]:bg-brand-tint"
                        >
                          {ui.breadcrumb.allServices}
                        </a>
                      </li>
                      {services.map((sv) => (
                        <li>
                          <a
                            href={sv.href}
                            aria-current={path === sv.href ? 'page' : undefined}
                            class="menu-item py-1 text-[0.9375rem]"
                          >
                            {sv.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </details>
                </li>
              ) : (
                <li>
                  <a
                    href={item.href}
                    aria-current={isActive(item.href) ? 'page' : undefined}
                    class="menu-item text-base font-medium"
                  >
                    {item.label}
                  </a>
                </li>
              );
            })
          }
        </ul>
        <a href={site.cta.href} class="btn btn-primary mt-2 w-full">{site.cta.label}</a>
      </div>
    </details>
  </nav>
</header>

<script>
  // Cabeçalho mais compacto (e com filete) depois que a página rola.
  const header = document.getElementById('site-header');
  if (header) {
    let ticking = false;
    const update = () => {
      header.toggleAttribute('data-scrolled', window.scrollY > 8);
      ticking = false;
    };
    update();
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
  }

  // Menu mobile: fecha ao tocar fora, ao apertar Esc ou ao escolher um link.
  const menu = document.getElementById('mobile-menu') as HTMLDetailsElement | null;
  if (menu) {
    const close = () => (menu.open = false);
    document.addEventListener('click', (e) => {
      if (!menu.open) return;
      const target = e.target as Element;
      if (!menu.contains(target) || target.closest('a')) close();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.open) {
        close();
        menu.querySelector('summary')?.focus();
      }
    });
  }

  // Submenu de Serviços (desktop): Esc o esconde sem tirar o foco (WCAG 1.4.13); volta a abrir ao sair e entrar de novo.
  for (const item of document.querySelectorAll<HTMLElement>('[data-submenu]')) {
    const reopen = () => delete item.dataset.closed;
    item.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') item.dataset.closed = '';
    });
    item.addEventListener('mouseleave', reopen);
    item.addEventListener('focusout', (e) => {
      if (!item.contains(e.relatedTarget as Node | null)) reopen();
    });
  }
</script>
