---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import mascot from '../assets/brand/mascot.png';
import wordmark from '../assets/brand/wordmark-tagline.png';
import { site, ui } from '../lib/content';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`);
---

<header
  class="sticky top-0 z-50 border-b border-line bg-white/95 backdrop-blur supports-[backdrop-filter]:bg-white/85"
>
  <nav class="container-page flex h-16 items-center justify-between md:h-20" aria-label={ui.nav.mainAria}>
    <a href="/" class="flex items-center gap-3" aria-label={ui.nav.homeAria}>
      <Image src={mascot} alt="" width={44} height={53} class="h-11 w-auto md:h-14" loading="eager" />
      <Image
        src={wordmark}
        alt={ui.nav.logoAlt}
        width={180}
        height={41}
        class="h-8 w-auto md:h-10"
        loading="eager"
      />
    </a>

    <ul class="hidden items-center gap-1 md:flex">
      {
        site.nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class="rounded-control px-3 py-2 text-sm font-medium text-ink-soft transition-colors hover:text-brand-dark aria-[current=page]:font-semibold aria-[current=page]:text-brand-dark aria-[current=page]:underline aria-[current=page]:decoration-brand aria-[current=page]:decoration-2 aria-[current=page]:underline-offset-8"
            >
              {item.label}
            </a>
          </li>
        ))
      }
      <li class="ml-3"><a href={site.cta.href} class="btn btn-primary">{site.cta.label}</a></li>
    </ul>

    <details class="group relative md:hidden">
      <summary
        class="flex size-11 cursor-pointer list-none items-center justify-center rounded-control text-ink hover:bg-surface [&::-webkit-details-marker]:hidden"
        aria-label={ui.nav.openMenu}
      >
        <Icon name="lucide:menu" class="size-6 group-open:hidden" aria-hidden="true" />
        <Icon name="lucide:x" class="hidden size-6 group-open:block" aria-hidden="true" />
      </summary>
      <div class="absolute right-0 top-14 w-72 rounded-card border border-line bg-white p-2 shadow-card-hover">
        <ul class="flex flex-col">
          {
            site.nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                  class="flex min-h-11 items-center rounded-control px-3 text-base font-medium text-ink hover:bg-surface aria-[current=page]:bg-brand-tint aria-[current=page]:font-semibold aria-[current=page]:text-brand-dark"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
        <a href={site.cta.href} class="btn btn-primary mt-2 w-full">{site.cta.label}</a>
      </div>
    </details>
  </nav>
</header>
