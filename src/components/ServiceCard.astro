---
import { Icon } from 'astro-icon/components';

interface Props {
  slug: string;
  title: string;
  description: string;
  icon: string;
  cta: string;
}
const { slug, title, description, icon, cta } = Astro.props;
---

<article class="card card-link group relative flex h-full flex-col p-6">
  <span class="flex size-12 items-center justify-center rounded-control bg-brand-tint text-brand-dark">
    <Icon name={`lucide:${icon}`} class="size-6" aria-hidden="true" />
  </span>
  <h3 class="mt-5 text-lg font-semibold leading-snug">{title}</h3>
  <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-soft">{description}</p>
  <a
    href={`/servicos/${slug}`}
    class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-dark after:absolute after:inset-0 after:content-[''] group-hover:underline"
  >
    {cta}
    <Icon name="lucide:arrow-right" class="size-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
    <span class="sr-only"> — {title}</span>
  </a>
</article>
