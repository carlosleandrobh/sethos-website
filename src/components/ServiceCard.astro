---
import { Icon } from 'astro-icon/components';

interface Props {
  slug: string;
  title: string;
  description: string;
  icon: string;
  cta: string;
  /** Nível do título do card: 2 quando a página não tem um título de seção antes (ex.: /servicos). */
  headingLevel?: 2 | 3;
}
const { slug, title, description, icon, cta, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as const;
---

<!-- Card inteiro clicável: o link se estende sobre ele (after:inset-0) e o foco contorna o card todo. -->
<article
  class="card-link group flex h-full flex-col p-5 md:p-6"
>
  <span class="flex size-11 items-center justify-center rounded-control bg-brand-tint text-brand-dark">
    <Icon name={`lucide:${icon}`} class="size-5" aria-hidden="true" />
  </span>
  <Heading class="mt-5 text-lg font-semibold leading-snug transition-colors group-hover:text-brand-dark">{title}</Heading>
  <p class="mt-2 text-[0.9375rem] leading-relaxed text-ink-soft">{description}</p>
  {/* Link estático: o ::after se estica sobre o card (que é relative); só a seta fica no canto. */}
  <a href={`/servicos/${slug}`} class="card-link-target text-brand-dark">
    <span class="sr-only">{cta} — {title}</span>
    <Icon
      name="lucide:arrow-right"
      class="absolute right-5 top-7 size-5 transition-transform duration-200 group-hover:translate-x-1 md:right-6 md:top-8"
      aria-hidden="true"
    />
  </a>
</article>
