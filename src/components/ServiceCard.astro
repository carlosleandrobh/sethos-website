---
import { Icon } from 'astro-icon/components';

interface Props {
  slug: string;
  title: string;
  description: string;
  icon: string;
  cta: string;
}
const { slug, title, description, icon, cta } = Astro.props;
---

<article class="group relative flex h-full gap-4 border-t border-ink/20 py-6">
  <Icon name={`lucide:${icon}`} class="mt-0.5 size-6 shrink-0 text-brand-dark" aria-hidden="true" />
  <div>
    <h3 class="text-lg font-semibold leading-snug">{title}</h3>
    <p class="mt-2 text-[0.9375rem] leading-relaxed text-ink-soft">{description}</p>
    <a
      href={`/servicos/${slug}`}
      class="mt-4 inline-block font-semibold text-brand-dark underline decoration-brand/40 decoration-2 underline-offset-4 transition-colors after:absolute after:inset-0 after:content-[''] group-hover:decoration-brand"
    >
      {cta}<span class="sr-only"> — {title}</span>
    </a>
  </div>
</article>
